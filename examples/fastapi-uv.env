# Python with uv (FastAPI, or any project with a pyproject.toml)
# Run:  treepot uv run fastapi dev --host 0.0.0.0     -> http://<app ip>:8000
IMAGE=ghcr.io/astral-sh/uv:python3.13-bookworm
SETUP='uv sync'
CACHE=/cache
APP_ENV=(UV_PROJECT_ENVIRONMENT=/cache/venv UV_LINK_MODE=copy)
DB=postgres   # postgres | mysql | none
