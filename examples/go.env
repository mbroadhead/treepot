# Go (CLI tools, libraries, or servers)
# Run:  treepot go run .     treepot go test ./...
# Binaries built in the VM are Linux ones. For a Mac binary:  treepot env GOOS=darwin go build
IMAGE=golang:1.26
SETUP='go mod download'
CACHE=/cache
APP_ENV=(GOMODCACHE=/cache/mod GOCACHE=/cache/build)
# DB=postgres   # postgres | mysql; leave unset for no database VM
