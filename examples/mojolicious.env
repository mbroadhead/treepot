# Perl with a cpanfile (Mojolicious, Dancer)
# Run:  treepot perl app.pl daemon -l http://0.0.0.0:3000     -> http://<app ip>:3000
IMAGE=perl:5.40
SETUP='cpanm -n -q -L /cache/perl5 --installdeps .'   # -n skips module test suites
CACHE=/cache
APP_ENV=(PERL5LIB=/cache/perl5/lib/perl5)
DB=postgres   # postgres | mysql | none
