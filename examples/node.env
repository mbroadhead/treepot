# Node with npm (Express, Next.js, ...)
# Run:  treepot npm run dev     (make the server listen on 0.0.0.0)
IMAGE=node:22
SETUP='npm install'
# node_modules lives in a per-worktree volume, so Linux builds of native modules never mix with the host's.
CACHE=$TOP/node_modules
DB=postgres   # postgres | mysql | none
