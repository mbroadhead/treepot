# Python with pip and requirements.txt (Django, Flask)
# Run:  treepot python manage.py runserver 0.0.0.0:8000     -> http://<app ip>:8000
# Django does not read DATABASE_URL by itself: use dj-database-url, or PGHOST/PGUSER/PGPASSWORD/PGDATABASE in settings.
IMAGE=python:3.13
SETUP='[ -x /cache/venv/bin/pip ] || python -m venv /cache/venv; pip install -q -r requirements.txt'
CACHE=/cache
APP_ENV=(VIRTUAL_ENV=/cache/venv PATH=/cache/venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin)
DB=postgres   # postgres | mysql | none
