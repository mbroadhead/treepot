#!/usr/bin/env bash
# treepot: run the current git worktree of a project (Rails auto-detected, anything else via config) in Apple `container` micro-VMs.
set -euo pipefail

TREEPOT_HOME="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
TREEPOT_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/treepot"

die() { echo "treepot: $*" >&2; exit 1; }

# ---- detection (pure functions of an app dir; covered by test/detect_test.sh) ----

detect_ruby() {
  local d=$1 v=""
  if [[ -f $d/.ruby-version ]]; then
    v=$(tr -d '[:space:]' < "$d/.ruby-version"); v=${v#ruby-}
  elif [[ -f $d/.tool-versions ]]; then
    v=$(awk '$1=="ruby"{print $2; exit}' "$d/.tool-versions")
  elif [[ -f $d/Gemfile.lock ]]; then
    v=$(awk '/^RUBY VERSION/{getline; print $2; exit}' "$d/Gemfile.lock"); v=${v%%p[0-9]*}
  fi
  echo "$v"
}

has_gem() { [[ -f $1/Gemfile.lock ]] && grep -Eq "^    $2 \(" "$1/Gemfile.lock"; }

# Prints the DATABASE_URL scheme: postgres | mysql2 | trilogy | sqlite
detect_db() {
  if has_gem "$1" pg; then echo postgres
  elif has_gem "$1" mysql2; then echo mysql2
  elif has_gem "$1" trilogy; then echo trilogy
  else echo sqlite; fi
}

project_for() { # <git common dir>
  if [[ $(basename "$1") == .git ]]; then basename "$(dirname "$1")"; else basename "$1" .git; fi
}

# shortcut: two worktrees of one project with the same directory name collide; add a path hash if that ever happens.
slug_for() { # <worktree top> <project>
  local wt s=$2
  wt=$(basename "$1")
  if [[ $wt == "$2" || $wt == "$2"-* ]]; then s=$wt; else s="$2-$wt"; fi
  printf '%s' "$s" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-'
}

# ---- container helpers ----

state() { container inspect "$1" 2>/dev/null | jq -r '.[0].status.state // empty' 2>/dev/null || true; }
ip() { container inspect "$1" | jq -r '.[0].status.networks[0].ipv4Address' | cut -d/ -f1; }

ensure_running() { # <name> <container run args...>
  local name=$1; shift
  case "$(state "$name")" in
    running) ;;
    "") container run -d --name "$name" "$@" >/dev/null ;;
    *) container start "$name" >/dev/null ;;
  esac
}

wait_port() { # <ip> <port>; DB images only open TCP once init has finished
  local i
  for i in $(seq 60); do
    (exec 3<>"/dev/tcp/$1/$2") 2>/dev/null && return 0
    sleep 1
  done
  die "nothing listening on $1:$2 after 60s"
}

build_image() {
  container build -t "$IMAGE" --build-arg "RUBY_VERSION=$RUBY_VERSION" \
    --build-arg "APT_PACKAGES=${APT_PACKAGES:-}" "$TREEPOT_HOME"
}

# ---- commands ----

cmd_up() {
  local env=(-e BINDING=0.0.0.0
    -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e "GIT_CONFIG_VALUE_0=*")
  local db_ip kv
  # Rails names its databases in database.yml; everything else gets a ready-made "app" database in the URL.
  local dbname=/app; [[ ! -f $TOP/config/database.yml ]] || dbname=""
  for kv in ${APP_ENV[@]+"${APP_ENV[@]}"}; do env+=(-e "$kv"); done

  if [[ -z ${IMAGE_SET:-} ]] && ! container image inspect "$IMAGE" >/dev/null 2>&1; then build_image; fi

  case $DB in
    postgres)
      # PGDATA in a subdir: a fresh volume's lost+found makes initdb refuse the mount root.
      ensure_running "$SLUG-db" -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=app -e PGDATA=/var/lib/postgresql/data/pgdata \
        -v "$SLUG-dbdata:/var/lib/postgresql/data" "${DB_IMAGE:-postgres:17}"
      db_ip=$(ip "$SLUG-db"); wait_port "$db_ip" 5432
      env+=(-e "DATABASE_URL=postgresql://postgres:postgres@$db_ip$dbname" -e "DB_HOST=$db_ip"
        -e "PGHOST=$db_ip" -e PGUSER=postgres -e PGPASSWORD=postgres) ;;
    mysql|mysql2|trilogy)
      # --datadir in a subdir for the same lost+found reason.
      ensure_running "$SLUG-db" -e MYSQL_ROOT_PASSWORD=root -e MARIADB_ROOT_PASSWORD=root -e MYSQL_DATABASE=app \
        -v "$SLUG-dbdata:/var/lib/treepot" "${DB_IMAGE:-mysql:8.4}" --datadir=/var/lib/treepot/data
      db_ip=$(ip "$SLUG-db"); wait_port "$db_ip" 3306
      env+=(-e "DATABASE_URL=$DB://root:root@$db_ip$dbname" -e "DB_HOST=$db_ip" -e "MYSQL_HOST=$db_ip") ;;
    sqlite|none) ;;
    *) die "unknown DB '$DB' (postgres, mysql, mysql2, trilogy, none)" ;;
  esac

  if [[ $REDIS == 1 ]]; then
    ensure_running "$SLUG-redis" "${REDIS_IMAGE:-redis:7}"
    env+=(-e "REDIS_URL=redis://$(ip "$SLUG-redis"):6379/0")
  fi

  # Same absolute paths as the host: a linked worktree's .git file points at the main repo by absolute path.
  local mounts=(-v "$TOP:$TOP")
  [[ $COMMON == "$TOP"/* ]] || mounts+=(-v "$COMMON:$COMMON")
  [[ -z $CACHE ]] || mounts+=(-v "$SLUG-cache:$CACHE")

  # Recreated every time so the DB/redis IPs baked into its env are never stale.
  container rm -f "$SLUG-app" >/dev/null 2>&1 || true
  container run -d --name "$SLUG-app" -c "${CPUS:-4}" -m "${MEMORY:-4G}" \
    "${mounts[@]}" -w "$TOP" "${env[@]}" \
    "$IMAGE" sleep infinity >/dev/null

  [[ -z $SETUP ]] || container exec -w "$TOP" "$SLUG-app" sh -c "$SETUP"
  echo "up: $SLUG (image $IMAGE, db $DB)"
  if [[ -f $TOP/Gemfile ]]; then
    echo "  treepot rails db:prepare && treepot rails s   ->   http://$(ip "$SLUG-app"):3000"
  else
    echo "  run commands with 'treepot <command>'; a server bound to 0.0.0.0 is reachable at $(ip "$SLUG-app")"
  fi
}

cmd_exec() {
  [[ $(state "$SLUG-app") == running ]] || die "$SLUG-app is not running; run 'treepot up' first"
  local tty=(-i); [[ -t 0 && -t 1 ]] && tty=(-i -t)
  local wd=$PWD; [[ $wd == "$TOP" || $wd == "$TOP"/* ]] || wd=$TOP
  exec container exec "${tty[@]}" -w "$wd" "$SLUG-app" "$@"
}

cmd_status() {
  container ls -a --format json | jq -r --arg s "$SLUG" '
    .[] | select(.configuration.id == ($s+"-app") or .configuration.id == ($s+"-db") or .configuration.id == ($s+"-redis"))
    | [.configuration.id, .status.state, (.status.networks[0].ipv4Address // "-" | split("/")[0])] | @tsv'
}

cmd_down() {
  local c
  for c in app db redis; do
    [[ -z $(state "$SLUG-$c") ]] || container rm -f "$SLUG-$c" >/dev/null
  done
  echo "down: $SLUG (volumes kept)"
}

cmd_destroy() {
  if [[ ${1:-} != -f ]]; then
    read -r -p "Delete $SLUG's VMs AND its database + dependency volumes? [y/N] " a
    [[ $a == y || $a == Y ]] || die "aborted"
  fi
  cmd_down
  local v
  for v in cache dbdata bundle; do container volume rm "$SLUG-$v" >/dev/null 2>&1 || true; done  # bundle: pre-generic-mode name
  echo "destroyed: $SLUG"
}

cmd_init() { # <template>: copy a starter config for this project
  local ex=$TREEPOT_HOME/examples
  [[ -n ${1:-} && -f $ex/$1.env ]] || die "usage: treepot init <template>; templates: $(cd "$ex" && ls ./*.env | sed 's|^\./||; s|\.env$||' | tr '\n' ' ')"
  [[ ! -e $CFG ]] || die "$CFG already exists"
  mkdir -p "$TREEPOT_CONFIG" && cp "$ex/$1.env" "$CFG"
  echo "wrote $CFG; review it, then run 'treepot up'"
}

usage() {
  cat <<EOF
usage: treepot <command>   (run inside any git worktree of your app)
  up            start this worktree's VMs (app + db [+ redis]) and install dependencies
  <anything>    run it in the app VM, e.g. treepot rails s, treepot bash, treepot uv run pytest
  status        this worktree's VMs, state and IPs
  down          remove the VMs, keep volumes
  destroy [-f]  down + delete the database and dependency volumes
  init <name>   write a starter config for a non-Ruby app (run 'treepot init' to list templates)
  build         (re)build the app image for this Ruby version (Ruby apps only)
Ruby/Rails apps are auto-detected. Anything else, and any override: $TREEPOT_CONFIG/<project>.env  (see README)
EOF
}

main() {
  [[ $# -gt 0 && $1 != -h && $1 != --help && $1 != help ]] || { usage; exit 0; }
  command -v container >/dev/null || die "Apple 'container' CLI not found (brew install container && container system start)"

  TOP=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  COMMON=$(git rev-parse --path-format=absolute --git-common-dir)
  local project; project=$(project_for "$COMMON")
  SLUG=$(slug_for "$TOP" "$project")

  # shellcheck disable=SC1090  # the config may use $TOP
  CFG=$TREEPOT_CONFIG/$project.env
  if [[ $1 == init ]]; then cmd_init "${2:-}"; exit; fi
  [[ ! -f $CFG ]] || source "$CFG"
  IMAGE_SET=${IMAGE:-}
  if [[ -f $TOP/Gemfile ]]; then
    : "${RUBY_VERSION:=$(detect_ruby "$TOP")}"
    : "${DB:=$(detect_db "$TOP")}"
    [[ $DB != mysql ]] || DB=mysql2  # the URL scheme Rails expects
    if [[ -z ${REDIS:-} ]]; then REDIS=0; ! has_gem "$TOP" redis || REDIS=1; fi
    [[ -n $IMAGE_SET || -n $RUBY_VERSION ]] || die "can't detect the Ruby version; set RUBY_VERSION in $CFG"
    : "${IMAGE:=treepot-ruby:$RUBY_VERSION}"
    : "${SETUP=bundle check >/dev/null 2>&1 || bundle install}"
    : "${CACHE=/usr/local/bundle}"
  else
    [[ -n $IMAGE_SET ]] || die "no Gemfile in $TOP, so nothing to auto-detect; for a non-Ruby app run 'treepot init <template>' (run 'treepot init' to list them) or write $CFG by hand"
    : "${DB:=none}" "${REDIS:=0}" "${SETUP=}" "${CACHE=}"
  fi

  case $1 in
    up) cmd_up ;;
    status) cmd_status ;;
    down) cmd_down ;;
    destroy) cmd_destroy "${2:-}" ;;
    build) [[ -z $IMAGE_SET ]] || die "IMAGE is set, so there is nothing to build"; build_image ;;
    *) cmd_exec "$@" ;;
  esac
}

[[ ${BASH_SOURCE[0]} != "$0" ]] || main "$@"
