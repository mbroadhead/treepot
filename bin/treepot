#!/usr/bin/env bash
# treepot: run the current git worktree of a project (Rails auto-detected, anything else via config) in Apple `container` micro-VMs.
set -euo pipefail

TREEPOT_HOME="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
TREEPOT_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/treepot"
PRESETS="postgres mysql redis"

die() { echo "treepot: $*" >&2; exit 1; }

# ---- detection (pure functions of a project dir; covered by test/detect_test.sh) ----

detect_ruby() {
  local d=$1 v=""
  if [[ -f $d/.ruby-version ]]; then
    v=$(tr -d '[:space:]' < "$d/.ruby-version"); v=${v#ruby-}
  elif [[ -f $d/.tool-versions ]]; then
    v=$(awk '$1=="ruby"{print $2; exit}' "$d/.tool-versions")
  elif [[ -f $d/Gemfile.lock ]]; then
    v=$(awk '/^RUBY VERSION/{getline; print $2; exit}' "$d/Gemfile.lock"); v=${v%%p[0-9]*}
  fi
  echo "$v"
}

has_gem() { [[ -f $1/Gemfile.lock ]] && grep -Eq "^    $2 \(" "$1/Gemfile.lock"; }

# Prints the preset services a project's dependency files mention, one per line.
# shortcut: a text search for known driver names, not a dependency resolver; unknown drivers need a [service] section by hand.
detect_services() {
  local d=$1 f files=()
  for f in Gemfile.lock pyproject.toml requirements.txt package.json cpanfile go.mod; do
    [[ ! -f $d/$f ]] || files+=("$d/$f")
  done
  [[ ${#files[@]} -gt 0 ]] || return 0
  ! grep -Eqs '^    pg \(|psycopg|asyncpg|"pg"|"postgres"|DBD::Pg|Mojo::Pg|jackc/pgx|lib/pq' "${files[@]}" || echo postgres
  ! grep -Eqs '^    (mysql2|trilogy) \(|mysqlclient|[Pp]y[Mm]y[Ss][Qq][Ll]|aiomysql|"mysql2?"|DBD::(mysql|MariaDB)|Mojo::mysql|go-sql-driver/mysql' "${files[@]}" || echo mysql
  ! grep -Eqs "^    redis \(|^redis([^a-z-]|$)|\"redis[\">=<~[]|\"ioredis\"|'(Mojo::)?Redis'|go-redis|gomodule/redigo" "${files[@]}" || echo redis
}

# Prints the starter template that fits a project dir, or nothing.
detect_template() {
  local d=$1
  if [[ -f $d/Gemfile ]]; then echo ruby-bundler
  elif [[ -f $d/go.mod ]]; then echo go
  elif [[ -f $d/uv.lock || -f $d/pyproject.toml ]]; then echo python-uv
  elif [[ -f $d/requirements.txt ]]; then echo python-pip
  elif [[ -f $d/cpanfile || -f $d/Makefile.PL || -f $d/Build.PL ]]; then echo perl-cpanm
  elif [[ -f $d/package.json ]]; then echo node-npm
  fi
}

# Project root for a directory outside git: the nearest ancestor that already has a treepot config,
# else the nearest one with a dependency manifest, else the directory itself. $HOME and / are never roots.
find_root() { # <start dir> <config dir>
  local d pass
  for pass in config manifest; do
    d=$1
    while [[ $d != / && $d != "$HOME" ]]; do
      if [[ $pass == config ]]; then
        [[ ! -f $2/$(basename "$d").ini ]] || { echo "$d"; return; }
      else
        [[ -z $(detect_template "$d") ]] || { echo "$d"; return; }
      fi
      d=$(dirname "$d")
    done
  done
  echo "$1"
}

project_for() { # <git common dir>
  if [[ $(basename "$1") == .git ]]; then basename "$(dirname "$1")"; else basename "$1" .git; fi
}

# shortcut: two worktrees of one project with the same directory name collide; add a path hash if that ever happens.
slug_for() { # <worktree top> <project>
  local wt s=$2
  wt=$(basename "$1")
  if [[ $wt == "$2" || $wt == "$2"-* ]]; then s=$wt; else s="$2-$wt"; fi
  printf '%s' "$s" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-'
}

# ---- config: an INI file read with git's own parser ($CFG may not exist) ----

cfg() { [[ ! -f $CFG ]] || git config -f "$CFG" --get "$1" || true; }
cfg_all() { [[ ! -f $CFG ]] || git config -f "$CFG" --get-all "$1" || true; }
cfg_has() { [[ -f $CFG ]] && git config -f "$CFG" --get "$1" >/dev/null; }
# Names of the [service "<name>"] sections, in file order.
cfg_services() {
  [[ ! -f $CFG ]] || git config -f "$CFG" --name-only --list | sed -nE 's/^service\.(.*)\.[^.]+$/\1/p' | awk '!seen[$0]++'
}

preset_image() {
  case $1 in postgres) echo postgres:17 ;; mysql) echo mysql:8.4 ;; redis) echo redis:7 ;; esac
}

# ---- container helpers ----

state() { container inspect "$1" 2>/dev/null | jq -r '.[0].status.state // empty' 2>/dev/null || true; }
ip() { container inspect "$1" | jq -r '.[0].status.networks[0].ipv4Address' | cut -d/ -f1; }

# jq: the address to show for a VM. Its DNS name when Apple container's local DNS covers it
# ($d = domains the Mac can resolve, from `container system dns list`), otherwise its IP.
JQ_ADDR='def addr: (.status.networks[0] // {}) as $n | (($n.hostname // "") | rtrimstr(".")) as $h
  | ($h | split(".")[1:] | join(".")) as $dom
  | if $dom != "" and ($d | any(. == $dom)) then $h else (($n.ipv4Address // "-") | split("/")[0]) end;'
dns_domains() { container system dns list 2>/dev/null | awk 'NR>1{print $1}' | jq -Rsc 'split("\n") | map(select(. != ""))'; }
addr() { container inspect "$1" | jq -r --argjson d "$(dns_domains)" "$JQ_ADDR .[0] | addr"; }

# Everything treepot creates is labelled with the worktree's slug, so status/down/destroy never depend on the current config.
ensure_running() { # <name> <container run args...>
  local name=$1; shift
  case "$(state "$name")" in
    running) ;;
    "") container run -d --name "$name" -l "treepot=$SLUG" "$@" >/dev/null ;;
    *) container start "$name" >/dev/null ;;
  esac
}

volume() { container volume create --label "treepot=$SLUG" "$1" >/dev/null 2>&1 || true; }  # fails harmlessly if it exists

wait_port() { # <ip> <port>; DB images only open TCP once init has finished
  local i
  for i in $(seq 60); do
    (exec 3<>"/dev/tcp/$1/$2") 2>/dev/null && return 0
    sleep 1
  done
  die "nothing listening on $1:$2 after 60s"
}

build_image() {
  container build -t "$IMAGE" --build-arg "RUBY_VERSION=$RUBY_VERSION" \
    --build-arg "APT_PACKAGES=$(cfg app.apt)" "$TREEPOT_HOME"
}

# Starts one service VM and records how the app reaches it in APP_ARGS (env) and HOSTS (name resolution).
start_service() { # <name>
  local name=$1 c="$SLUG-$1" image port="" kv path sip scheme
  local run=()  # everything after the container name for `container run`
  [[ $name =~ ^[a-z][a-z0-9-]*$ && $name != app ]] || die "bad service name '$name' in $CFG (lowercase letters, digits, dashes; not 'app')"
  image=$(cfg "service.$name.image"); [[ -n $image ]] || image=$(preset_image "$name")
  [[ -n $image ]] || die "service '$name' needs 'image = ...' in $CFG"
  while IFS= read -r kv; do [[ -z $kv ]] || run+=(-e "$kv"); done < <(cfg_all "service.$name.env")

  case $name in
    postgres)
      port=5432; volume "$c-data"
      # PGDATA in a subdir: a fresh volume's lost+found makes initdb refuse the mount root.
      run+=(-e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=app -e PGDATA=/var/lib/postgresql/data/pgdata
        -v "$c-data:/var/lib/postgresql/data" "$image") ;;
    mysql)
      port=3306; volume "$c-data"
      # --datadir in a subdir for the same lost+found reason.
      run+=(-e MYSQL_ROOT_PASSWORD=root -e MARIADB_ROOT_PASSWORD=root -e MYSQL_DATABASE=app
        -v "$c-data:/var/lib/treepot" "$image" --datadir=/var/lib/treepot/data) ;;
    redis)
      port=6379; run+=("$image") ;;
    *)
      port=$(cfg "service.$name.port"); path=$(cfg "service.$name.volume")
      if [[ -n $path ]]; then volume "$c-data"; run+=(-v "$c-data:$path"); fi
      run+=("$image") ;;
  esac

  ensure_running "$c" "${run[@]}"
  sip=$(ip "$c")
  [[ -z $port ]] || wait_port "$sip" "$port"
  HOSTS+="$sip $name"$'\n'
  APP_ARGS+=(-e "$(printf '%s' "$name" | tr 'a-z-' 'A-Z_')_HOST=$sip")

  case $name in
    postgres)
      APP_ARGS+=(-e "POSTGRES_URL=postgresql://postgres:postgres@$sip$DBNAME"
        -e "PGHOST=$sip" -e PGUSER=postgres -e PGPASSWORD=postgres)
      [[ -n $HAVE_DB ]] || APP_ARGS+=(-e "DATABASE_URL=postgresql://postgres:postgres@$sip$DBNAME" -e "DB_HOST=$sip")
      HAVE_DB=1 ;;
    mysql)
      scheme=mysql  # Rails wants its adapter name as the scheme
      if has_gem "$TOP" mysql2; then scheme=mysql2; elif has_gem "$TOP" trilogy; then scheme=trilogy; fi
      APP_ARGS+=(-e "MYSQL_URL=$scheme://root:root@$sip$DBNAME")
      [[ -n $HAVE_DB ]] || APP_ARGS+=(-e "DATABASE_URL=$scheme://root:root@$sip$DBNAME" -e "DB_HOST=$sip")
      HAVE_DB=1 ;;
    redis)
      APP_ARGS+=(-e "REDIS_URL=redis://$sip:6379/0") ;;
  esac
}

# ---- commands ----

cmd_up() {
  local s kv cpus mem
  APP_ARGS=(-e BINDING=0.0.0.0
    -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e "GIT_CONFIG_VALUE_0=*")
  HOSTS="" HAVE_DB=""
  # Rails names its databases in database.yml; everything else gets a ready-made "app" database in the URL.
  DBNAME=/app; [[ ! -f $TOP/config/database.yml ]] || DBNAME=""

  if [[ -n $BUILD ]] && ! container image inspect "$IMAGE" >/dev/null 2>&1; then build_image; fi

  for s in $SERVICES; do start_service "$s"; done
  while IFS= read -r kv; do [[ -z $kv ]] || APP_ARGS+=(-e "$kv"); done < <(cfg_all app.env)

  # Same absolute paths as the host: a linked worktree's .git file points at the main repo by absolute path.
  APP_ARGS+=(-v "$TOP:$TOP")
  [[ $COMMON == "$TOP"/* ]] || APP_ARGS+=(-v "$COMMON:$COMMON")
  if [[ -n $CACHE ]]; then volume "$SLUG-app-cache"; APP_ARGS+=(-v "$SLUG-app-cache:$CACHE"); fi

  # Recreated every time so the service addresses baked into its env and /etc/hosts are never stale.
  container rm -f "$SLUG-app" >/dev/null 2>&1 || true
  cpus=$(cfg app.cpus); mem=$(cfg app.memory)
  ensure_running "$SLUG-app" -c "${cpus:-4}" -m "${mem:-4G}" -w "$TOP" "${APP_ARGS[@]}" "$IMAGE" sleep infinity
  [[ -z $HOSTS ]] || printf '%s' "$HOSTS" | container exec -i "$SLUG-app" sh -c 'cat >> /etc/hosts' \
    || echo "treepot: couldn't write service names to /etc/hosts; use the *_HOST variables" >&2

  [[ -z $SETUP ]] || container exec -w "$TOP" "$SLUG-app" sh -c "$SETUP"
  echo "up: $SLUG"
  cmd_status | sed 's/^/  /'
  if [[ -f $TOP/bin/rails ]]; then
    echo "next: treepot rails db:prepare && treepot rails s   ->   http://$(addr "$SLUG-app"):3000"
  else
    echo "next: treepot <command>   (a server must bind 0.0.0.0 to be reachable from the Mac)"
  fi
  [[ $(addr "$SLUG-app") == *[a-z]* ]] || echo "tip: run 'treepot dns' once for stable names ($SLUG-app.test) instead of IPs"
}

cmd_exec() {
  [[ $(state "$SLUG-app") == running ]] || die "$SLUG-app is not running; run 'treepot up' first"
  local tty=(-i); [[ -t 0 && -t 1 ]] && tty=(-i -t)
  local wd=$PWD; [[ $wd == "$TOP" || $wd == "$TOP"/* ]] || wd=$TOP
  exec container exec "${tty[@]}" -w "$wd" "$SLUG-app" "$@"
}

cmd_status() {
  container ls -a --format json | jq -r --arg s "$SLUG" --argjson d "$(dns_domains)" "$JQ_ADDR"'
    .[] | select(.configuration.labels.treepot == $s)
    | [(.configuration.id | ltrimstr($s + "-")), .status.state, addr] | @tsv' \
    | sort | awk -F'\t' '{printf "%-12s %-8s %s\n", $1, $2, $3}'
}

cmd_down() {
  local c
  for c in $(container ls -a --format json | jq -r --arg s "$SLUG" '.[] | select(.configuration.labels.treepot == $s) | .configuration.id'); do
    container rm -f "$c" >/dev/null
  done
  echo "down: $SLUG (volumes kept)"
}

cmd_destroy() {
  local v
  if [[ ${1:-} != -f ]]; then
    read -r -p "Delete $SLUG's VMs AND its data + dependency volumes? [y/N] " a
    [[ $a == y || $a == Y ]] || die "aborted"
  fi
  cmd_down
  for v in $(container volume ls --format json | jq -r --arg s "$SLUG" '.[] | select(.configuration.labels.treepot == $s) | .id'); do
    container volume rm "$v" >/dev/null
  done
  echo "destroyed: $SLUG"
}

dns_configured() { # the domain container registers VMs under, or nothing
  container system property list 2>/dev/null | awk '/^\[dns\]/{f=1; next} /^\[/{f=0} f && $1=="domain"{gsub(/"/, "", $3); print $3}'
}

cmd_dns() { # [status | <domain>]: one-time setup of Apple container's local DNS, for stable names instead of IPs
  local want=${1:-} conf=$HOME/.config/container/config.toml cur reg a
  cur=$(dns_configured); reg=$(container system dns list 2>/dev/null | awk 'NR>1{print $1}' | tr '\n' ' ')
  if [[ $want == status ]]; then
    echo "container's DNS domain:   ${cur:-not set}"
    echo "resolvable from this Mac: ${reg:-none}"
    if [[ -n $cur && " $reg " == *" $cur "* ]]; then
      echo "ok: VMs are reachable as <project>-<worktree>-<service>.$cur"
    else
      echo "not set up: run 'treepot dns'"
    fi
    return
  fi
  : "${want:=${cur:-test}}"
  [[ $want =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || die "bad domain '$want' (e.g. test, vm, dev.internal)"

  if [[ $cur != "$want" ]]; then
    [[ -z $cur ]] || die "container's DNS domain is already '$cur'; run 'treepot dns' to finish setting that one up, or change it in $conf yourself"
    # Never edit a config we did not write.
    [[ ! -e $conf ]] || die "$conf already exists. Add these two lines to it, run 'container system stop && container system start', then re-run 'treepot dns $want':
[dns]
domain = \"$want\""
    echo "This sets container's DNS domain to '$want' and restarts Apple container."
    echo "The restart stops ALL running VMs, in every worktree ($(container ls -q 2>/dev/null | wc -l | tr -d ' ') running now)."
    read -r -p "Continue? [y/N] " a
    [[ $a == y || $a == Y ]] || die "aborted"
    mkdir -p "$(dirname "$conf")" && printf '[dns]\ndomain = "%s"\n' "$want" > "$conf"
    container system stop >/dev/null && container system start >/dev/null
  fi
  if [[ " $reg " != *" $want "* ]]; then
    echo "Registering .$want with macOS; sudo may ask for your password."
    sudo container system dns create "$want"
  fi
  echo "done: after the next 'treepot up', VMs are reachable as <project>-<worktree>-<service>.$want"
}

cmd_init() { # [template] [--with a,b|none]: write a starter config for this project
  local ex=$TREEPOT_HOME/examples t="" with="" picked=detected s list
  while [[ $# -gt 0 ]]; do
    case $1 in
      --with) [[ $# -ge 2 ]] || die "--with needs a value, e.g. --with postgres,redis"; with=$2; picked=chosen; shift 2 ;;
      *) t=$1; shift ;;
    esac
  done
  list=$(cd "$ex" && ls ./*.ini | sed 's|^\./||; s|\.ini$||' | tr '\n' ' ')
  [[ -n $t ]] || t=$(detect_template "$TOP")
  [[ -n $t ]] || die "can't tell what kind of project this is; run 'treepot init <template>' with one of: $list"
  [[ -f $ex/$t.ini ]] || die "no template '$t'; templates: $list"
  [[ ! -e $CFG ]] || die "$CFG already exists"

  if [[ $picked == chosen ]]; then with=$(printf '%s' "$with" | tr ',' ' '); else with=$(detect_services "$TOP" | tr '\n' ' '); fi
  with=$(echo $with)  # normalise whitespace
  [[ $with != none ]] || with=""
  for s in $with; do
    [[ " $PRESETS " == *" $s "* ]] || die "'$s' is not a built-in service ($PRESETS); add a [service \"$s\"] section to the config by hand"
  done

  mkdir -p "$TREEPOT_CONFIG" && cp "$ex/$t.ini" "$CFG"
  for s in $with; do printf '\n[service "%s"]\n    image = %s\n' "$s" "$(preset_image "$s")" >> "$CFG"; done
  echo "template: $t"
  echo "services: ${with:-none} ($picked; change with --with postgres,mysql,redis or by editing the file)"
  echo "wrote $CFG; review it, then run 'treepot up'"
}

usage() {
  cat <<EOF
usage: treepot <command>   (run anywhere inside your project; each git worktree is its own environment)
  up            start this worktree's VMs (app + services) and install dependencies
  <anything>    run it in the app VM, e.g. treepot rails s, treepot bash, treepot uv run pytest
  status        this worktree's VMs, state and addresses
  down          remove the VMs, keep volumes
  destroy [-f]  down + delete the data and dependency volumes
  init [template] [--with postgres,mysql,redis|none]
                write a starter config; picks the template and services from the project if not given
  dns [domain]  one-time setup of stable names (<worktree>-app.test) instead of IPs; 'dns status' to check
  build         (re)build the app image for this Ruby version (Ruby apps only)
Rails apps need no config. Anything else, and any override: $TREEPOT_CONFIG/<project>.ini  (see README)
EOF
}

main() {
  [[ $# -gt 0 && $1 != -h && $1 != --help && $1 != help ]] || { usage; exit 0; }
  command -v container >/dev/null || die "Apple 'container' CLI not found (brew install container && container system start)"

  if [[ $1 == dns ]]; then shift; cmd_dns "$@"; exit; fi

  # Without git there are no worktrees: the project is one directory, found by its config or manifest.
  if TOP=$(git rev-parse --show-toplevel 2>/dev/null); then
    COMMON=$(git rev-parse --path-format=absolute --git-common-dir)
  else
    TOP=$(find_root "$PWD" "$TREEPOT_CONFIG") COMMON=$TOP/.git
  fi
  local project; project=$(project_for "$COMMON")
  SLUG=$(slug_for "$TOP" "$project")
  CFG=$TREEPOT_CONFIG/$project.ini

  if [[ $1 == init ]]; then shift; cmd_init "$@"; exit; fi
  [[ ! -f $CFG ]] || git config -f "$CFG" --list >/dev/null || die "can't parse $CFG"
  [[ -f $CFG || ! -f ${CFG%.ini}.env ]] || die "${CFG%.ini}.env is the old config format; delete it and run 'treepot init'"

  IMAGE=$(cfg app.image) SETUP=$(cfg app.setup) CACHE=$(cfg app.cache) SERVICES=$(cfg_services) BUILD=""
  if [[ -f $TOP/Gemfile ]]; then
    RUBY_VERSION=$(cfg app.ruby); [[ -n $RUBY_VERSION ]] || RUBY_VERSION=$(detect_ruby "$TOP")
    if [[ -z $IMAGE ]]; then
      [[ -n $RUBY_VERSION ]] || die "can't detect the Ruby version; set 'ruby = x.y.z' under [app] in $CFG"
      IMAGE=treepot-ruby:$RUBY_VERSION BUILD=1
    fi
    cfg_has app.setup || SETUP='bundle check >/dev/null 2>&1 || bundle install'
    cfg_has app.cache || CACHE=/usr/local/bundle
    [[ -n $SERVICES ]] || SERVICES=$(detect_services "$TOP")
  else
    [[ -n $IMAGE ]] || die "no Gemfile in $TOP, so nothing to auto-configure; run 'treepot init' to write $CFG"
  fi
  [[ -z $CACHE || $CACHE == /* ]] || CACHE=$TOP/$CACHE  # relative = inside the worktree

  case $1 in
    up) cmd_up ;;
    status) cmd_status ;;
    down) cmd_down ;;
    destroy) cmd_destroy "${2:-}" ;;
    build) [[ -n $BUILD ]] || die "the app image is set in the config, so there is nothing to build"; build_image ;;
    *) cmd_exec "$@" ;;
  esac
}

[[ ${BASH_SOURCE[0]} != "$0" ]] || main "$@"
